# =============================================================================
# Go Monolith Application Environment Configuration
# =============================================================================

# Server Configuration
HOST=localhost
PORT=8080

# Environment
ENV=development

# Database Configuration
DB_PATH=./src/db/todo.db

# Application Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Development Tools
AIR_CONFIG=.air.toml

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# API Documentation
SWAGGER_ENABLED=true 